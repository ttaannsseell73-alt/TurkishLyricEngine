          "lines": [
            "Sen kal diye ben durmam",
            "Sevmek geri dönmek değil",
            "Kendim için bir adım var",
            "Benim yolum bana çıkar"
          ]
        },
        {
          "id": "verse2",
          "lines": [
            "İlk vapura yalnız bindim",
            "Aceleyle kitap aldım",
            "Bir sayfayı bitirince",
            "Düşüncemi geri aldım"
          ]
        },
        {
          "id": "prechorus2",
          "lines": [
            "Kolay değil bunu bilmek",
            "Yine de var dönmek için"
          ]
