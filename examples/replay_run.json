      "title": "Kendi Günüm",
      "sections": [
        {
          "id": "verse1",
          "lines": [
            "Bugün yine seni bekledim",
            "Erteledim bütün işlerimi",
            "Bir haberin gelmez diye",
            "Saatleri sana verdim"
          ]
        },
        {
          "id": "prechorus",
          "lines": [
            "Ben kendime geç kalmışım",
            "Şimdi karar bende kalsın"
          ]
        },
        {
